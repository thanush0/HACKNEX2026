APP_NAME=SCENERA API
APP_VERSION=1.0.0
DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173
DEVICE=auto
ENABLE_GPU=true
ENABLE_VIDEO=true
PRELOAD_MODEL=false
SD_MODEL_ID=runwayml/stable-diffusion-inpainting
SDXL_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
MODEL_CACHE_DIR=./models
MAX_UPLOAD_SIZE_MB=20
MAX_VIDEO_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_FRAMES=9000
VIDEO_TEMPORAL_STRENGTH=0.12
VIDEO_MAX_WORKING_SIDE=1024
